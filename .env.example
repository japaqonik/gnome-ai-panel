# Environment variables read by GNOME AI Panel (PLAN §13). Copy to .env only for local
# experiments; .env is git-ignored. Never put real secrets in this file.

# Path to the configuration file (default: $XDG_CONFIG_HOME/gnome-ai-panel/config.toml).
AI_PANEL_CONFIG=
# Log level: DEBUG, INFO (default), WARNING, ERROR.
AI_PANEL_LOG_LEVEL=INFO
# 1 = register debug D-Bus actions (debug-send, debug-click, debug-dump). Tests/UAT only.
AI_PANEL_DEBUG=
# Overrides default_agent from config.toml (agent id).
AI_PANEL_DEFAULT_AGENT=
# Tests: write opened URIs to this file instead of launching the browser.
AI_PANEL_URI_LOG=
# Tests of the installer: 1 = skip `gnome-extensions install`.
AI_PANEL_SKIP_EXTENSION_INSTALL=
# Tests of make run/run-headless/stop: state directory instead of .run/ (pid files, logs,
# headless.env, isolated home).
AI_PANEL_RUN_DIR=
# Playwright browser for `make test-ui`: webkit or chromium. Empty: webkit when it can
# launch, otherwise chromium with a warning (scripts/pick-browser.mjs).
PW_BROWSER=

# Example only: a variable an agent could read through a config entry like
#   env.ANTHROPIC_API_KEY = { source = "env", name = "ANTHROPIC_API_KEY" }
# Prefer the "keyring" source for real keys. Leave empty here.
ANTHROPIC_API_KEY=
