{
  "name": "gnome-ai-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Dev tooling for GNOME AI Panel (vendored UI libraries, lint, UI tests). Not needed at runtime.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern app/ui extension tests/ui tests/gjs",
    "test:ui": "playwright test --pass-with-no-tests",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "dompurify": "3.4.17",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "highlight.js": "11.12.0",
    "marked": "18.2.0"
  }
}
